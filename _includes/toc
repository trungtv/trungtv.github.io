<nav class="toc toc--inline" aria-label="{{ page.toc_label | default: 'Mục lục' }}">
  <header>
    <h4 class="nav__title">
      <i class="fa fa-{{ page.toc_icon | default: 'list' }}" aria-hidden="true"></i>
      {{ page.toc_label | default: site.data.ui-text[site.locale].toc_label | default: "Mục lục" }}
    </h4>
  </header>
  {% comment %}
    flat_toc + item_class: giữ đủ mọi heading (kể cả khi bài nhảy cấp h3→h1),
    đồng thời thể hiện hierarchy bằng indent theo cấp.
  {% endcomment %}
  {% include toc.html sanitize=true html=content h_min=1 h_max=3 class="toc__menu" item_class="toc__item toc__item--h%level%" skip_no_ids=true flat_toc=true %}
</nav>
