<aside class="sidebar__right{% if page.toc_sticky %} sticky{% endif %}">
  <nav class="toc">
    <header>
      <h4 class="nav__title">
        <i class="fa fa-{{ page.toc_icon | default: 'list' }}" aria-hidden="true"></i>
        {{ page.toc_label | default: site.data.ui-text[site.locale].toc_label | default: "Mục lục" }}
      </h4>
    </header>
    {% include toc.html sanitize=true html=content h_min=1 h_max=3 class="toc__menu" skip_no_ids=true flat_toc=true %}
  </nav>
</aside>
